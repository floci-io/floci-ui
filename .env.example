# floci-api config (packages/api)
FLOCI_ENDPOINT=http://localhost:4566
FLOCI_AZURE_ENDPOINT=http://localhost:4577
FLOCI_AZURE_ACCOUNT_NAME=devstoreaccount1
FLOCI_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
FLOCI_AZURE_RESOURCE_GROUP=floci-local
FLOCI_OCI_ENDPOINT=http://localhost:4599
VITE_MOCK_MODE=false
# Rootless Podman only: uncomment to point docker-compose.yml at Podman's
# Docker-compatible socket instead of the absent /var/run/docker.sock.
# FLOCI_CONTAINER_SOCKET=/run/user/1000/podman/podman.sock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=4501
